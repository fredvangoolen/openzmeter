  (pad 2 thru_hole oval (at 35.8 9.55) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask))
  (pad "" np_thru_hole oval (at -27.6 17.5) (size 3.45 3.45) (drill 3.45) (layers *.Cu *.Mask))
  (pad "" np_thru_hole oval (at 27.6 -17.5) (size 3.45 3.45) (drill 3.45) (layers *.Cu *.Mask))
  (model "${KIPRJMOD}/3DLibs/18650 battery holder part.STEP"
