  (pad 3 thru_hole oval (at -35.8 9.55) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask))
  (pad 2 thru_hole oval (at 35.8 -9.55) (size 2.4 2.4) (drill 1.2) (layers *.Cu *.Mask))
