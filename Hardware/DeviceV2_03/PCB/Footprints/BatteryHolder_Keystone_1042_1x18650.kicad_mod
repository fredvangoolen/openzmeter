  (fp_line (start 38.55 19.9) (end -38.55 19.9) (layer F.SilkS) (width 0.12))
  (fp_line (start -38.55 -19.9) (end -38.55 19.9) (layer F.SilkS) (width 0.12))
  (fp_line (start 38.55 -19.9) (end -38.55 -19.9) (layer F.SilkS) (width 0.12))
  (fp_line (start 38.55 -19.9) (end 38.55 19.9) (layer F.SilkS) (width 0.12))
  (fp_text user %R (at 0 0) (layer F.Fab)
