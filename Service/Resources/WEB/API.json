{
  "openapi": "3.0.1",
  "info": {
    "title": "openZmeter API",
    "version": "1.1.0",
    "description": "Full API definition of openZmeter daemon. Not all functions are avaliable on all systems, not for all users or not all time.",
    "license": {
      "name": "GNU General Public License v3.0",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Analyzers",
      "description": "Analyzer information queries."
    },
    {
      "name": "Tariffs",
      "description": "Manage tariffs."
    },
    {
      "name": "System",
      "description": "System management functions."
    }
  ],
  "paths": {
    "/logIn": {
      "post": {
        "summary": "Authorize to access the system",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "UserName",
                  "Password"
                ],
                "example": {
                  "UserName": "test",
                  "Password": "test",
                  "UpdateLastLogin": true
                },
                "properties": {
                  "UserName": {
                    "type": "string"
                  },
                  "Password": {
                    "type": "string"
                  },
                  "UpdateLastLogin": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "LastLogin": 1000000
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Cookie value for current session",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "On missing params"
          },
          "401": {
            "description": "On invalid login params"
          }
        }
      }
    },
    "/logOut": {
      "post": {
        "summary": "Close active user session",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {},
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          }
        }
      }
    },
    "/getDevices": {
      "post": {
        "summary": "Get list of avaliable system devices",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {},
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "Analyzers": 1,
                    "Driver": "V2",
                    "Enabled": true,
                    "Name": "Capture device V2",
                    "Serial": "F100A1009034E42413032302"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/getDevice": {
      "post": {
        "summary": "Get device configuration (Each device driver have its own properties)",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": false,
                  "Frequency": 50,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230
                }
              }
            }
          }
        }
      }
    },
    "/setDevice": {
      "post": {
        "summary": "Set device configuration (Each device driver have its own properties)",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": true,
                  "Frequency": 60,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230,
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          }
        }
      }
    }
  }
}