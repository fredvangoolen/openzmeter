{
  "openapi": "3.0.1",
  "info": {
    "title": "openZmeter API",
    "version": "1.1.0",
    "description": "Full API definition of openZmeter daemon. Not all functions are avaliable on all systems, not for all users or not all time.",
    "license": {
      "name": "GNU General Public License v3.0",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    { "url": "/" }
  ],
  "components": {
    "schemas": {
      "RateTemplate": {
        "type": "object"
      }
    }
  },
  "tags": [
    {
      "name": "Devices",
      "description": "Devices configuration and listing"
    },
    {
      "name": "Ethernet",
      "description": "Manage ethernet connection, if avaliable"
    },
    {
      "name": "WIFI",
      "description": "Manage WiFi connection, if avaliable"
    },
    {
      "name": "ModbusTCP",
      "description": "Manage modbusTCP services"
    },
    {
      "name": "Telegram",
      "description": "Manage Telegram bot services"
    },
    {
      "name": "Updates",
      "description": "Search and install system package updates"
    },
    {
      "name": "NTP",
      "description": "Manage NTP (network time protocol) client configuration, if avaliable."
    }
  ],
  "paths": {
    "/setAnalyzer": {
      "post": {
        "summary": "Get analyzer details",
        "tags": [
          "Analyzers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Analyzer": "xxxxxxxxxx"
                },
                "properties": {
                  "Analyzer": {
                    "type": "string"
                  }
                },
                "required": [
                  "Analyzer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "AlarmsEnabled": true,
                  "EventsEnabled": true,
                  "MQTT": {
                    "Enabled": false,
                    "Export10M": false,
                    "Export15M": false,
                    "Export1H": false,
                    "Export1M": true,
                    "Export3S": true,
                    "ExportAlarms": false,
                    "ExportConfig": false,
                    "Pass": "",
                    "Prefix": "/OZM",
                    "Server": "mqtt://test.mosquitto.org",
                    "User": ""
                  },
                  "MaxCurrent": 35,
                  "MinCurrent": 0.1,
                  "Mode": "1PHASE",
                  "Name": "Unnamed analyzer",
                  "NominalFrequency": 50,
                  "NominalVoltage": 230,
                  "Online": true,
                  "SampleRate": 24000,
                  "Save200MS": true,
                  "Sync": {
                    "Enabled": false,
                    "Pass": "",
                    "Server": "",
                    "User": ""
                  },
                  "Tags": [],
                  "TimeZone": "UTC"
                }
              }
            }
          }
        }
      }
    },
    "/testAlarm": {
      "post": {
        "summary": "Get analyzer serie",
        "tags": [
          "Analyzers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Analyzer": "xxxxxxxxxx",
                  "Series": [
                    "Voltage",
                    "Current"
                  ]
                },
                "properties": {
                  "Analyzer": {
                    "type": "string"
                  },
                  "Aggreg": {
                    "type": "string",
                    "enum": [
                      "200MS",
                      "3S",
                      "1M",
                      "10M",
                      "15M",
                      "1H"
                    ]
                  },
                  "From": {
                    "type": "number"
                  },
                  "To": {
                    "type": "number"
                  },
                  "Series": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "Voltage",
                        "Current",
                        "Active_Power",
                        "Reactive_Power",
                        "Active_Energy",
                        "Reactive_Energy",
                        "Voltage_Samples",
                        "Voltage_THD",
                        "Phi",
                        "Power_Factor"
                      ]
                    }
                  }
                },
                "required": [
                  "Analyzer",
                  "Series"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  [
                    "Time",
                    "Voltage"
                  ],
                  [
                    1599307199999,
                    [
                      239.383
                    ]
                  ],
                  [
                    1599310799999,
                    [
                      241.35
                    ]
                  ],
                  [
                    1599314399999,
                    [
                      236.431
                    ]
                  ]
                ]
              }
            }
          }
        }
      }
    },
    "/getDevices": {
      "post": {
        "summary": "Get list of avaliable system devices",
        "tags": [
          "Devices"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {},
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "Analyzers": 1,
                    "Driver": "V2",
                    "Enabled": true,
                    "Name": "Capture device V2",
                    "Serial": "F100A1009034E42413032302"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/getDevice": {
      "post": {
        "summary": "Get device configuration (Each device driver have its own properties)",
        "tags": [
          "Devices"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": false,
                  "Frequency": 50,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230
                }
              }
            }
          }
        }
      }
    },
    "/setDevice": {
      "post": {
        "summary": "Set device configuration (Each device driver have its own properties)",
        "tags": [
          "Devices"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": true,
                  "Frequency": 60,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230,
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          }
        }
      }
    },
    "/getEthernet": {
      "post": {
        "summary": "Get ethernet configuration",
        "tags": [
          "Ethernet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "DNS": [
                    "192.168.1.1",
                    "8.8.8.8"
                  ],
                  "Enabled": true,
                  "Gateway": "192.168.1.1",
                  "IP": "192.168.1.92",
                  "IPMode": "DHCP",
                  "Netmask": "255.255.255.0",
                  "Status": {
                    "Connected": true,
                    "DNS": [
                      "192.168.1.1",
                      "8.8.8.8",
                      "192.168.0.1"
                    ],
                    "Gateway": "192.168.0.1",
                    "IP": "192.168.0.87",
                    "IPMode": "DHCP"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Configuration can not be read"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setEthernet": {
      "post": {
        "summary": "Set ethernet configuration",
        "tags": [
          "Ethernet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "DNS",
                  "Enabled",
                  "Gateway",
                  "IP",
                  "IPMode",
                  "Netmask"
                ],
                "example": {
                  "DNS": [
                    "192.168.1.1",
                    "8.8.8.8"
                  ],
                  "Enabled": true,
                  "Gateway": "192.168.1.1",
                  "IP": "192.168.1.92",
                  "IPMode": "DHCP",
                  "Netmask": "255.255.255.0"
                },
                "properties": {
                  "DNS": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "Gateway": {
                    "type": "string"
                  },
                  "IP": {
                    "type": "string"
                  },
                  "IPMode": {
                    "type": "string",
                    "enum": [
                      "STATIC",
                      "DHCP"
                    ]
                  },
                  "Netmask": {
                    "type": "string"
                  },
                  "Enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Configuration can not be saved"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/getUpdates": {
      "post": {
        "summary": "Get avaliable updates for installed packages. If 'Force' is true, update package list from update server",
        "tags": [
          "Updates"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Force": true
                },
                "properties": {
                  "Force": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "From": "20191219.1025",
                    "Package": "openZmeter-devel",
                    "To": "20200509.2103"
                  },
                  {
                    "From": "2.16.6-1",
                    "Package": "libmbedtls",
                    "To": "2.16.7-1"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Can not get avaliable updates"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setUpgrade": {
      "post": {
        "summary": "Upgrade requested packages",
        "tags": [
          "Updates"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Packages": [
                    "openZmeter-devel"
                  ]
                },
                "properties": {
                  "Pacakages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upgrading is taking place",
            "content": {
              "text/event-stream": {
                "example": "event: text\ndata: console messages...\n\nevent: status\ndata: OK (Upgrade finished)\n\n"
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Can not upgrade requested packages"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/getWIFI": {
      "post": {
        "summary": "Get WiFi configuration",
        "tags": [
          "WIFI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "DNS": [
                    "192.168.1.1",
                    "8.8.8.8"
                  ],
                  "ESSID": "WIFI",
                  "Enabled": true,
                  "Gateway": "192.168.1.1",
                  "IP": "192.168.1.92",
                  "IPMode": "DHCP",
                  "Key": "xxxxxxxxxx",
                  "KeyMode": "WPA2",
                  "Netmask": "255.255.255.0",
                  "Status": {
                    "Channel": 11,
                    "Connected": true,
                    "DNS": [
                      "192.168.1.1",
                      "8.8.8.8",
                      "192.168.0.1"
                    ],
                    "ESSID": "WIFI",
                    "Gateway": "192.168.0.1",
                    "IP": "192.168.0.87",
                    "IPMode": "DHCP",
                    "Quality": 68
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Configuration can not be read"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setWIFI": {
      "post": {
        "summary": "Set bluetooth configuration",
        "tags": [
          "WIFI"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "DNS",
                  "ESSID",
                  "Enabled",
                  "Gateway",
                  "IP",
                  "IPMode",
                  "Key",
                  "KeyMode",
                  "Netmask"
                ],
                "example": {
                  "DNS": [
                    "192.168.1.1",
                    "8.8.8.8"
                  ],
                  "ESSID": "WIFI",
                  "Enabled": true,
                  "Gateway": "192.168.1.1",
                  "IP": "192.168.1.92",
                  "IPMode": "DHCP",
                  "Key": "xxxxxxxxxx",
                  "KeyMode": "WPA2",
                  "Netmask": "255.255.255.0"
                },
                "properties": {
                  "DNS": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ESSID": {
                    "type": "string"
                  },
                  "Gateway": {
                    "type": "string"
                  },
                  "IP": {
                    "type": "string"
                  },
                  "IPMode": {
                    "type": "string",
                    "enum": [
                      "STATIC",
                      "DHCP"
                    ]
                  },
                  "Key": {
                    "type": "string"
                  },
                  "KeyMode": {
                    "type": "string",
                    "enum": [
                      "NONE",
                      "WEP",
                      "WPA",
                      "WPA2"
                    ]
                  },
                  "Netmask": {
                    "type": "string"
                  },
                  "Enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "500": {
            "description": "Configuration can not be saved"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/getNTP": {
      "post": {
        "summary": "Get NPT configuration",
        "tags": [
          "NTP"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Enabled": true,
                  "Server": "hora.roa.es",
                  "Time": 1598430332332
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setNTP": {
      "post": {
        "summary": "Set NTP configuration, if Server is disabled, 'Time' values is set as local UTC time",
        "tags": [
          "NTP"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Enabled",
                  "Server",
                  "Time"
                ],
                "example": {
                  "Enabled": true,
                  "Server": "hora.roa.es",
                  "Time": 1598430332332
                },
                "properties": {
                  "Enabled": {
                    "type": "boolean"
                  },
                  "Server": {
                    "type": "string"
                  },
                  "Time": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    }
  }
}