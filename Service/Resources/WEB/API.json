  "paths": {
    "/logIn": {
      "post": {
        "summary": "Authorize to access the system",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "UserName",
                  "Password"
                ],
                "example": {
                  "UserName": "test",
                  "Password": "test",
                  "UpdateLastLogin": true
                },
                "properties": {
                  "UserName": {
                    "type": "string"
                  },
                  "Password": {
                    "type": "string"
                  },
                  "UpdateLastLogin": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "LastLogin": 1000000
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Cookie value for current session",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "On missing params"
          },
          "401": {
            "description": "On invalid login params"
          }
        }
      }
    },
    "/logOut": {
      "post": {
        "summary": "Close active user session",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {},
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          }
        }
      }
    },
    "/getDevices": {
      "post": {
        "summary": "Get list of avaliable system devices",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {},
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "Analyzers": 1,
                    "Driver": "V2",
                    "Enabled": true,
                    "Name": "Capture device V2",
                    "Serial": "F100A1009034E42413032302"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/getDevice": {
      "post": {
        "summary": "Get device configuration (Each device driver have its own properties)",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": false,
                  "Frequency": 50,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230
                }
              }
            }
          }
        }
      }
    },
    "/setDevice": {
      "post": {
        "summary": "Set device configuration (Each device driver have its own properties)",
        "tags": [
          "System"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Serial"
                ],
                "example": {
                  "Current": 5,
                  "CurrentPhase": -10.1,
                  "Enabled": true,
                  "Frequency": 60,
                  "Mode": "3PHASE+N",
                  "SampleRate": 10000,
                  "Voltage": 230,
                  "Serial": "VIRTUAL"
                },
                "properties": {
                  "Serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          }
        }
      }
    },
    "/getBluetooth": {
      "post": {
        "summary": "Get bluetooth configuration",
        "tags": [
          "Bluetooth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Enabled": true,
                  "Interface": "br-bt",
                  "Name": "openZmeter_xxxx"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setBluetooth": {
      "post": {
        "summary": "Set bluetooth configuration",
        "tags": [
          "Bluetooth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Enabled"
                ],
                "example": {
                  "Enabled": true
                },
                "properties": {
                  "Enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/getNTP": {
      "post": {
        "summary": "Get NPT configuration",
        "tags": [
          "NTP"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Enabled": true,
                  "Server": "hora.roa.es",
                  "Time": 1598430332332
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/setNTP": {
      "post": {
        "summary": "Set NTP configuration, if Server is disabled, 'Time' values is set as local UTC time",
        "tags": [
          "NTP"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Enabled",
                  "Server",
                  "Time"
                ],
                "example": {
                  "Enabled": true,
                  "Server": "hora.roa.es",
                  "Time": 1598430332332
                },
                "properties": {
                  "Enabled": {
                    "type": "boolean"
                  },
                  "Server": {
                    "type": "string"
                  },
                  "Time": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          },
          "503": {
            "description": "Function not avaliable"
          }
        }
      }
    },
    "/getTariffs": {
      "post": {
        "summary": "Get configured tariffs list",
        "tags": [
          "Tariffs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "Name": "ESP_2.0A",
                    "UserName": "admin"
                  },
                  {
                    "Name": "ESP_2.0DHA",
                    "UserName": "admin"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Not logged in"
          }
        }
      }
    },
    "/getTariff": {
      "post": {
        "summary": "Get full tariff configuration",
        "tags": [
          "Tariffs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Name"
                ],
                "example": {
                  "Name": "ESP_2,0A"
                },
                "properties": {
                  "Name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TariffTemplate"
                    },
                    {
                      "type": "object",
                      "example": {"UserName": "admin"},
                      "properties": {
                        "UserName": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "501": {
            "description": "Tariff name not found"
          }
        }
      }
    },
    "/setTariff": {
      "post": {
        "summary": "Update tariff configuration",
        "tags": [
          "Tariffs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TariffTemplate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "501": {
            "description": "Tariff name not found"
          }
        }
      }
    },
    "/addTariff": {
      "post": {
        "summary": "Add tariff configuration",
        "tags": [
          "Tariffs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TariffTemplate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "501": {
            "description": "Tariff name already exists"
          }
        }
      }
    },
    "/delTariff": {
      "post": {
        "summary": "Add tariff configuration",
        "tags": [
          "Tariffs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {"Name": "ESP_2.0A"},
                "properties": {
                  "Name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "501": {
            "description": "Tariff name not found or not owned by calling user"
          }
        }
      }
    },
    "/getESIOS": {
      "post": {
        "summary": "Get ESIOS price fetch module configuration",
        "tags": [
          "Price modules"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success",
            "content": {
              "application/json": {
                "example": {
                  "Enabled": false,
                  "LastDate": 1262304000000,
                  "Token": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          }
        }
      }
    },
    "/setESIOS": {
      "post": {
        "summary": "Set ESIOS price fecth module configuration",
        "tags": [
          "Price modules"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "Enabled",
                  "Token"
                ],
                "example": {
                  "Enabled": true,
                  "Token": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                },
                "properties": {
                  "Enabled": {
                    "type": "boolean"
                  },
                  "Token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "On success"
          },
          "401": {
            "description": "Not logged in"
          },
          "403": {
            "description": "Not admin user"
          }
        }
      }
    }
