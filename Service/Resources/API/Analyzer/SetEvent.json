{
  "paths": {
    "/setEvent": {
      "post": {
        "summary": "Set a note on an existing event",
        "tags": [ "Analyzers" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Analyzer": "VIRTUAL_3PN",
                  "StartTime": 1600000000000,
                  "Notes": "This is a note"
                },
                "properties": {
                  "Analyzer": { "type": "string" },
                  "StartTime": {"type": "number" },
                  "Notes": { "type": "string" }
                },
                "required": [ "Analyzer", "StartTime", "Notes" ]
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/200Response" },
          "400": { "$ref": "#/components/responses/400Response" },
          "401": { "$ref": "#/components/responses/401Response" },
          "403": { "$ref": "#/components/responses/403Response" },
          "500": { "$ref": "#/components/responses/500Response" }
        }
      }
    }
  }
}