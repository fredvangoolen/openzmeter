
{
  "components": {
    "schemas": {
      "AlarmTemplate": {
        "type": "object",
        "properties": {
          "Enabled": { "type": "boolean" },
          "AlarmID": { "type": "string" },
          "Name": { "type": "string" },
          "Priority": { "type": "number" },
          "Expression": { "type": "string" },
          "Aggreg": { "type": "string", "enum": [ "200MS", "3S", "1M", "10M", "15M", "1H" ] },
          "Samples": { "type": "number" },
          "Window": { "type": "number" }
        },
        "required": [ "Enabled", "AlarmID", "Name", "Priority", "Expression", "Aggreg", "Samples", "Window" ],
        "example": {
          "AlarmID": "00000000-0000-0000-0000-000000000000",
          "Enabled": true,
          "Name": "Alarm",
          "Priority": 0,
          "Expression": "Active_Power>100",
          "Aggreg": "3S",
          "Samples": 10,
          "Window": 20
        }
      },
      "MQTTTemplate": {
        "type": "object",
        "properties": {
          "Enabled": { "type": "boolean" },
          "Export10M": { "type": "boolean" },
          "Export15M": { "type": "boolean" },
          "Export1H": { "type": "boolean" },
          "Export1M": { "type": "boolean" },
          "Export200MS": { "type": "boolean" },
          "Export3S": { "type": "boolean" },
          "ExportAlarms": { "type": "boolean" },
          "ExportConfig": { "type": "boolean" },
          "Pass": { "type": "string" },
          "Prefix": { "type": "string" },
          "Server": { "type": "string" },
          "User": { "type": "string" }
        },
        "required": [ "Enabled", "Export10M", "Export15M", "Export1H", "Export1M", "Export200MS", "Export3S", "ExportAlarms", "ExportConfig", "Pass", "Prefix", "Server", "User" ],
        "example": {
          "Enabled": false,
          "Export10M": false,
          "Export15M": false,
          "Export1H": false,
          "Export1M": false,
          "Export200MS": false,
          "Export3S": true,
          "ExportAlarms": false,
          "ExportConfig": false,
          "Pass": "",
          "Prefix": "/OZM",
          "Server": "mqtt://test.mosquitto.org",
          "User": ""
        }
      },
      "PermissionTemplate": {
        "type": "object",
        "properties": {
          "Config": { "type": "boolean" },
          "Read": { "type": "boolean" },
          "User": { "type": "string" },
          "Write": { "type": "boolean" }
        },
        "required": [ "Config", "Read", "User", "Write" ],
        "example": {
          "Config": true,
          "Read": true,
          "User": "admin",
          "Write": true
        }
      },
      "TagsTemplate": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "example": {
          "foo": "bar"
        }
      },
      "SyncTemplate": {
        "type": "object",
        "properties": {
          "Enabled": { "type": "boolean" },
          "Pass": { "type": "string" },
          "Server": { "type": "string" },
          "User": { "type": "string" }
        },
        "required": [ "Enabled", "Pass", "Server", "User" ],
        "example": {
          "Enabled": false,
          "Pass": "admin",
          "Server": "192.168.0.1",
          "User": "admin"
        }
      }
    }
  },
  "paths": {
    "/getAnalyzer": {
      "post": {
        "summary": "Get list of avaliable analyzers",
        "tags": [ "Analyzers" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "example": {
                  "Analyzer": "VIRTUAL_3PN"
                },
                "properties": {
                  "Analyzer": { "type": "string" }
                },
                "required": [ "Analyzer" ]
              }
            }
          }
         },
        "responses": {
          "200": {
            "description": "The method executed without error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "AlarmsEnabled": { "type": "boolean" },
                    "EventsEnabled": { "type": "boolean" },
                    "MaxCurrent": { "type": "number" },
                    "MinCurrent": { "type": "number" },
                    "Mode": { "type": "string", "enum": ["1PHASE", "2PHASE", "2PHASE+N", "3PHASE", "3PHASE+N"] },
                    "Name": { "type": "string" },
                    "NominalFrequency": { "type": "number" },
                    "NominalVoltage": { "type": "number" },
                    "SampleRate": { "type": "number" },
                    "Save200MS": { "type": "boolean" },
                    "TimeZone": { "type": "boolean" },
                    "User": { "type": "string" },
                    "Alarms": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AlarmTemplate" }
                    },
                    "Users": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PermissionTemplate" }
                    },
                    "MQTT": { "$ref": "#/components/schemas/MQTTTemplate" },
                    "Tags": { "$ref": "#/components/schemas/TagsTemplate" },
                    "PhaseNames": { "type": "array", "items": { "type": "string"} },
                    "NeutralName": { "type": "string" },
                    "Sync": { "$ref": "#/components/schemas/SyncTemplate" },
                    "PriceModules": { "$ref": "#/components/schemas/PriceModuleTemplate" },
                    "Rates": { "type": "array", "items": { "$ref": "#/components/schemas/RateTemplate" } }
                  },
                  "required": [ "AlarmsEnabled", "EventsEnabled", "MaxCurrent", "MinCurrent", "Mode", "Name", "NominalFrequency", "NominalVoltage", "SampleRate", "Save200MS", "TimeZone", "User", "Alarms", "MQTT", "Users", "Tags", "PhaseNames", "Sync", "PriceModules", "Rates" ],
                  "example": {
                    "AlarmsEnabled": true,
                    "EventsEnabled": true,
                    "MaxCurrent": 35,
                    "MinCurrent": 0.1,
                    "Mode": "3PHASE+N",
                    "Name": "Unnamed analyzer",
                    "NominalFrequency": 50,
                    "NominalVoltage": 230,
                    "SampleRate": 100000,
                    "Save200MS": false,
                    "TimeZone": "Europe/Madrid",
                    "User": "admin",
                    "PhaseNames": [ "R", "S", "T" ],
                    "NeutralName": "N"
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/401Response" }
        }
      }
    }
  }
}