{
  "paths": {
    "/setTariff": {
      "post": {
        "summary": "Update tariff configuration",
        "tags": [ "Tariffs" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TariffTemplate" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/200Response" },
          "400": { "$ref": "#/components/responses/400Response" },
          "401": { "$ref": "#/components/responses/401Response" },
          "500": { "$ref": "#/components/responses/500Response" }
        }
      }
    }
  }
}