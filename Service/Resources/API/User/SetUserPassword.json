{
  "paths": {
    "/setUserPassword": {
      "post": {
        "summary": "Update user password",
        "tags": [ "Users" ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [ "User", "Password" ],
                "properties": {
                  "User": { "type": "string" },
                  "Password": { "type": "string" },
                  "PrevPassword": { "type": "string" }
                },
                "example": {
                  "User": "admin",
                  "Password": "admin",
                  "PrevPassword": "admin"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/200Response" },
          "400": { "$ref": "#/components/responses/400Response" },
          "401": { "$ref": "#/components/responses/401Response" },
          "403": { "$ref": "#/components/responses/403Response" },
          "500": { "$ref": "#/components/responses/500Response" }
        }
      }
    }
  }
}