{
  "components": {
    "schemas": {
      "UserListTemplate": {
        "type": "array",
        "items": {
          "type": "array",
          "example": [
            [ "User", "Name", "Email", "TimeZone"],
            [ "admin", "System administrator", "example@example.com", "UTC" ]
          ]
        }
      }
    }
  },
  "paths": {
    "/getUsers": {
      "post": {
        "summary": "Get user list",
        "tags": [ "Users" ],
        "requestBody": { "$ref": "#/components/requestBodies/EmptyObject" },
        "responses": {
          "200": {
            "description": "The method executed without error",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserListTemplate" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/401Response" },
          "403": { "$ref": "#/components/responses/403Response" }
        }
      }
    }
  }
}