#Enable/Disable device plugins (set to true or false) ------------------------------------------------------------------
DEVICE_V1_00   = false
DEVICE_V1_01   = true
DEVICE_V2_01   = true
DEVICE_VIRTUAL = true

#Target OS (set to DEBIAN or OPENWRT) ----------------------------------------------------------------------------------
OS_TARGET = OPENWRT

#Enable/Disable tariff plugins (set to true or false) ------------------------------------------------------------------
TARIFF_ESP  = true
TARIFF_NONE = true

# Build options --------------------------------------------------------------------------------------------------------
DEBUG    = true
CC       = arm-openwrt-linux-gcc
LD       = arm-openwrt-linux-ld
CFLAGS  += -I $(STAGING_DIR)/target-arm_cortex-a7+neon-vfpv4_musl_eabi/usr/include -I $(STAGING_DIR)/target-arm_cortex-a7+neon-vfpv4_musl_eabi/usr/include/dbus-1.0 -I $(STAGING_DIR)/target-arm_cortex-a7+neon-vfpv4_musl_eabi/usr/lib/dbus-1.0/include
LDFLAGS += -L $(STAGING_DIR)/target-arm_cortex-a7+neon-vfpv4_musl_eabi/usr/lib
