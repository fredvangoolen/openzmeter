#Enable/Disable device plugins (set to true or false) ------------------------------------------------------------------
DEVICE_V1_00   = false
DEVICE_V1_01   = true
DEVICE_V2_01   = true
DEVICE_VIRTUAL = true
DEVICE_REMOTE  = true

#Target OS (set to DEBIAN or OPENWRT) ----------------------------------------------------------------------------------
OS_TARGET = DEBIAN

#Enable/Disable tariff plugins (set to true or false) ------------------------------------------------------------------
TARIFF_ESP  = true
TARIFF_NONE = true


# Build options --------------------------------------------------------------------------------------------------------
DEBUG   = true
CC      = g++
LD      = ld
CFLAGS += -I /usr/include/postgresql

