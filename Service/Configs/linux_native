#Enable/Disable device plugins (set to true or false) ------------------------------------------------------------------
DEVICE_V1      = false
DEVICE_V2      = false
DEVICE_VIRTUAL = true
DEVICE_REMOTE  = false

#Target OS (set to DEBIAN or OPENWRT) ----------------------------------------------------------------------------------
OS_TARGET = DEBIAN

#Enable/Disable tariff plugins (set to true or false) ------------------------------------------------------------------
TARIFF_ESP  = true
TARIFF_NONE = true


# Build options --------------------------------------------------------------------------------------------------------
DEBUG   = true
CC      = g++
LD      = ld
CFLAGS += -I /usr/include/postgresql

