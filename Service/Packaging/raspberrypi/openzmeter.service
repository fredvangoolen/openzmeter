[Unit]
Description=openZmeter power quality analyzer
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=openzmeter
Group=openzmeter
# dialout: access to the USB/RS-422 serial adapter of the S1 port
SupplementaryGroups=dialout
ExecStart=/usr/local/sbin/openZmeter --config=/etc/openzmeter/openZmeter.conf
Restart=on-failure
RestartSec=5
# Analyzers flush pending data on shutdown
TimeoutStopSec=60

# PID file location configured in openZmeter.conf (/run/openzmeter/openZmeter.pid)
RuntimeDirectory=openzmeter
# Port 80 without root, and realtime priority for capture/analysis threads (falls back to nice if not allowed)
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_NICE

# Hardening. openZmeter rewrites its own config file, so /etc/openzmeter must stay writable.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/openzmeter
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
