#!/bin/sh
# installation script for openZmeter debian package
echo "Initializing or updating DB"
su postgres -c "psql" <  /usr/share/openZmeter/Database.sql &> /dev/null

systemctl stop openZmeter.service &> /dev/null
systemctl disable openZmeter.service &> /dev/null
systemctl daemon-reload
echo "Installing service"
echo "Enabling service"
systemctl enable openZmeter.service
systemctl start openZmeter.service
