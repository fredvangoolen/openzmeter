FROM alpine:3.8

#install packages ----------------------------------------------------------
RUN apk add --no-cache asciidoc bash bc binutils bzip2 cdrkit coreutils diffutils findutils flex g++ gawk gcc gettext git grep intltool libxslt linux-headers make ncurses-dev patch perl python2-dev python3-dev tar unzip  util-linux wget zlib-dev xz npm openssh-client curl

#Download openWRT ----------------------------------------------------------
RUN mkdir /opt && cd /opt && git clone https://git.openwrt.org/openwrt/openwrt.git openWRT_SDK
RUN cd /opt/openWRT_SDK && git checkout openwrt-19.07
RUN cd /opt/openWRT_SDK && ./scripts/feeds update -a && ./scripts/feeds install -a

#Setup openWRT SDK ---------------------------------------------------------
RUN echo "CONFIG_TARGET_ramips=y" > /opt/openWRT_SDK/.config
RUN echo "CONFIG_TARGET_ramips_mt76x8=y" >> /opt/openWRT_SDK/.config
RUN echo "CONFIG_TARGET_ramips_mt76x8_DEVICE_omega2p=y" >> /opt/openWRT_SDK/.config
RUN cd /opt/openWRT_SDK && make defconfig

#Generate required openWRT packages ----------------------------------------
ENV FORCE_UNSAFE_CONFIGURE=1
RUN cd /opt/openWRT_SDK && make tools/install V=sc -j32
RUN cd /opt/openWRT_SDK && make toolchain/install V=sc -j32
RUN cd /opt/openWRT_SDK && make package/usign/host/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/zlib/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/postgresql/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/openssl/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/wireless-tools/compile V=sc-j32
RUN cd /opt/openWRT_SDK && make package/dbus/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/libusb/compile V=sc -j32
RUN cd /opt/openWRT_SDK && BUILD_VARIANT="single" make package/fftw3/compile V=sc -j32
RUN cd /opt/openWRT_SDK && make package/util-linux/compile V=sc -j32

#Clean intermediate files --------------------------------------------------
RUN cd /opt/openWRT_SDK && rm -rf build_dir

# OpenWRT SDK --------------------------------------------------------------
ENV SDK_DIR "/opt/openWRT_SDK"
ENV STAGING_DIR "${SDK_DIR}/staging_dir"
ENV TOOLCHAIN "${STAGING_DIR}/toolchain-mipsel_24kc_gcc-7.5.0_musl"
ENV CC "mipsel-openwrt-linux-gcc"
ENV CXX "mipsel-openwrt-linux-g++"
ENV CMAKE_C_COMPILER "mipsel-openwrt-linux-gcc"
ENV CMAKE_CXX_COMPILER "mipsel-openwrt-linux-g++"
ENV STRIP "mipsel-openwrt-linux-strip"
ENV RANLIB "mipsel-openwrt-linux-ranlib"
ENV AS "mipsel-openwrt-linux-as"
ENV AR "mipsel-openwrt-linux-ar" 
ENV LD "mipsel-openwrt-linux-ld"
ENV PATH "${TOOLCHAIN}/bin:${SDK_DIR}/scripts:$STAGING_DIR/host/bin:${PATH}"
