FROM alpine:3.8

#install packages ----------------------------------------------------------
RUN apk add --no-cache asciidoc bash bc binutils bzip2 cdrkit coreutils diffutils findutils flex g++ gawk gcc gettext git grep intltool libxslt linux-headers make ncurses-dev patch perl python2-dev python3-dev tar unzip  util-linux wget zlib-dev xz npm openssh-client

#Download openWRT ----------------------------------------------------------
RUN mkdir /opt && cd /opt && git clone https://git.openwrt.org/openwrt/openwrt.git openWRT_SDK
RUN cd /opt/openWRT_SDK && git checkout openwrt-18.06    
RUN cd /opt/openWRT_SDK && ./scripts/feeds update -a && ./scripts/feeds install -a

#Setup openWRT SDK ---------------------------------------------------------
RUN echo "CONFIG_TARGET_sunxi=y" > /opt/openWRT_SDK/.config
RUN echo "CONFIG_TARGET_sunxi_cortexa7=y" >> /opt/openWRT_SDK/.config
RUN echo "CONFIG_TARGET_sunxi_cortexa7_DEVICE_sun8i-h3-nanopi-neo=y" >> /opt/openWRT_SDK/.config
RUN cd /opt/openWRT_SDK && make defconfig

#Generate required openWRT packages ----------------------------------------
ENV FORCE_UNSAFE_CONFIGURE=1
RUN cd /opt/openWRT_SDK && make tools/install -j8
RUN cd /opt/openWRT_SDK && make toolchain/install -j8
RUN cd /opt/openWRT_SDK && make package/usign/host/compile -j8
RUN cd /opt/openWRT_SDK && make package/zlib/compile -j8 
RUN cd /opt/openWRT_SDK && make package/libmicrohttpd/compile -j8
RUN cd /opt/openWRT_SDK && make package/postgresql/compile -j8
RUN cd /opt/openWRT_SDK && make package/curl/compile -j8
RUN cd /opt/openWRT_SDK && make package/wireless-tools/compile -j8
RUN cd /opt/openWRT_SDK && make package/dbus/compile -j8
RUN cd /opt/openWRT_SDK && make package/libusb/compile -j8
RUN cd /opt/openWRT_SDK && BUILD_VARIANT="single" make package/fftw3/compile -j8

# OpenWRT SDK --------------------------------------------------------------
ENV SDK_DIR "/opt/openWRT_SDK"
ENV STAGING_DIR "${SDK_DIR}/staging_dir"
ENV TOOLCHAIN "${STAGING_DIR}/toolchain-arm_cortex-a7+neon-vfpv4_gcc-7.3.0_musl_eabi"
ENV CC=arm-openwrt-linux-gcc  
ENV CXX=arm-openwrt-linux-g++  
ENV CMAKE_C_COMPILER=arm-openwrt-linux-gcc  
ENV CMAKE_CXX_COMPILER=arm-openwrt-linux-g++  
ENV STRIP=arm-openwrt-linux-strip  
ENV RANLIB=arm-openwrt-linux-ranlib 
ENV AS=arm-openwrt-linux-as  
ENV AR=arm-openwrt-linux-ar  
ENV LD=arm-openwrt-linux-ld
ENV PATH=${TOOLCHAIN}/bin:${SDK_DIR}/scripts:$STAGING_DIR/host/bin:${PATH}
