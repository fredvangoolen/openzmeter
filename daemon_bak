            work->voltageLastCycleSamples = NULL;
            work->prev = NULL;
            pthread_mutex_lock(&workList.lock);
            if (workList.head == NULL) {
                work->next = NULL;
            } else {
                work->next = workList.head;
            }
            workList.head = work;
            pthread_mutex_unlock(&workList.lock);

            thpool_add_work(thpool, (void*) processing, work);

