int sign(float x) {
    return (x > 0) - (x < 0);
}

/*
 * Obtención de 10 ciclos de tensión y conversión de short a float (d) para adaptarlo a librería FFTW.
 **/
int getFloatVoltagePLL(unsigned short *in, float **out, int *cycle_indexes, int* readCycles, int numCycles, int maxSamples, int firstRead) {
    int i;
    int cycleIndex = 0;
    int outLength = 0;
    if (!firstRead) {
        cycle_indexes[cycleIndex] = 0;
        cycleIndex++;
    }
    float tempOut[maxSamples];
    for (i = 0; i < maxSamples && cycleIndex < numCycles + 1; i++) {
        tempOut[i] = (((float) in[i] / (float) MAX2E12)*2 - 1);
        if (i > 0) {
            //printf("%04d | %f => %f \n", i, tempOut[i - 1], tempOut[i]);
            //fflush(stdout);
            if (sign(tempOut[i]) > sign(tempOut[i - 1])) {//Passing by zero
                //printf("PASO POR CERO! \n");
                //fflush(stdout);
                //if (numPassingByZero % 2 == 0) {//Cycle completion
                //printf("CICLO %d! \n", cycleIndex + 1);
                //fflush(stdout);
                cycle_indexes[cycleIndex] = i;
                cycleIndex++;
                //}
            }
        }
    }
    *readCycles = cycleIndex - firstRead ? 0 : 1;
    if (cycleIndex == 0 || (cycleIndex == 1 && !firstRead)) {//No cycles => Possible voltage drop
        outLength = maxSamples;
        cycle_indexes[0] = 0;
    } else {
        //if (numCycles == cycleIndex) {
        outLength = cycle_indexes[numCycles - 1] - cycle_indexes[0];
        debug_print_2("\nMuestra ejemplo antes reserva: %f\n", tempOut[cycle_indexes[0]]);
        //fflush(stdout);

        //} else {
        //Necesito más muestras...
        //    return maxSamples;
        //}
    }
    *out = NULL;
    *out = calloc(outLength, sizeof (float));
    memcpy(*out, tempOut + cycle_indexes[0], outLength);
    debug_print_2("\nReservando salida: %d para puntero %p\n", outLength, out);
    debug_print_2("\nPost reserva: %f\n", *out[0]);
    //fflush(stdout);
    return outLength;
}

void unshort2float(unsigned short *x, float *d, int n) {
    int i;
    for (i = 0; i < n; i++) {
        d[i] = (((float) x[i] / (float) MAX2E12)*2 - 1);
    }
}

void writeValue(s_influxdb_client* client, char* serie, float value, int64_t microsec) {
    int status;
    s_influxdb_series *series = influxdb_series_create(serie, NULL);
    influxdb_series_add_colums(series, "time");
    influxdb_series_add_colums(series, "value");
    int i = 0;
    char **tab1 = malloc(sizeof (char *) * 2);

    //TIME
    int64_t *timeUsec = malloc(sizeof (int64_t));
    *timeUsec = microsec;

    //VALUE
    double *valuePointer = malloc(sizeof (double));
    *valuePointer = value;

    tab1[0] = (char *) timeUsec;
    tab1[1] = (char *) valuePointer;
    influxdb_series_add_points(series, tab1);

    status = influxdb_write_serie_with_time_precision(client, series, INFLUXDB_TP_MICROSEC);

    influxdb_series_free(series, NULL);
}

void writeSamples(s_influxdb_client* client, uint16 *samples, uint32 packageSize, int64_t microsec, uint32 timestep) {
    //printf("Escribiendo muestras en influxdb para microsec %" PRId64 "...\n", microsec);
    int status;
    s_influxdb_series *series = influxdb_series_create("voltage", NULL);
    influxdb_series_add_colums(series, "time");
    influxdb_series_add_colums(series, "value");
    int i = 0;
    for (i = 0; i < packageSize; i++) {
        char **tab1 = malloc(sizeof (char *) * 2);

        //TIME
        int64_t *timeUsec = malloc(sizeof (int64_t));
        *timeUsec = microsec;

        //VALUE
        double *value = malloc(sizeof (double));
        *value = samples[i]*1.8 / 4095;

        tab1[0] = (char *) timeUsec;
        tab1[1] = (char *) value;
        influxdb_series_add_points(series, tab1);
        microsec += timestep;
    }

    status = influxdb_write_serie_with_time_precision(client, series, INFLUXDB_TP_MICROSEC);

    influxdb_series_free(series, NULL);
}

