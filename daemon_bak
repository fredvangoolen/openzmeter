                    debug_print_2("\nGuardo las muestras nuevas del ADC restantes a adcRemainingSamples. Escribiendo a posición %d la cantidad de %d muestras (Indice final de escritura: %d | indice máximo muestras: %d)\n", 0, numAdcRemainingSamples, numAdcRemainingSamples - 1, workingSamplesPerSignal - 1);
                    for (i = 0; i < numSignals; i++) {
                        memcpy(adcRemainingSamples[i], adcSamples[i] + samplesToComplete, sizeof (uint16) * numAdcRemainingSamples);
                    }
                }
            } else {
                /**
                 * STEP 1.2.1: Set workingSamples=remainingSamples
                 */
                debug_print_2("\nCopio las muestras restantes combinadas a workingSamples. Escribiendo a posición %d la cantidad de %d muestras (Indice final de escritura: %d | indice máximo muestras: %d)\n", 0, workingSamplesPerSignal, workingSamplesPerSignal - 1, workingSamplesPerSignal - 1);
                for (i = 0; i < numSignals; i++) {
                    memcpy(workingSamples[i], remainingSamples[i], sizeof (uint16) * workingSamplesPerSignal); //Copy remaining samples
                }
                numRemainingSamples -= workingSamplesPerSignal;
            }


            /**
             * STEP 2. Get 10 cycles of the signal from workingSamples => signalSamples and remainingSamples
             */
            debug_print_2("\n * PASO 2\n");
            int numCycles = 10;
            int readCycles = 0;
            float* voltage_in;
            float* current_in;
            int cycle_indexes[numCycles + 1];
            //float current_in[SAMPLES_PER_INTERVAL];
            int signalLength = 0;
            if (signalLength = getFloatVoltagePLL(workingSamples[0], &voltage_in, cycle_indexes, &readCycles, numCycles, workingSamplesPerSignal, firstRead)) {//We success getting the cycles
                //Get signal samples => voltage_in
                //Save remaining samples
                debug_print_2("\nMuestra ejemplo return: %f\n", voltage_in[0]);
                int remainingIndex = workingSamplesPerSignal;
                if (readCycles > 1) {
                    remainingIndex = cycle_indexes[readCycles];
                }
                int samplesToComplete = workingSamplesPerSignal - numRemainingSamples - remainingIndex;
                debug_print_2("\nGuardo las restantes de los 10 ciclos a las restantes combinadas. Escribiendo a posición numRemainingSamples [%d] la cantidad de %d muestras (Indice final de escritura: %d| indice máximo muestras: %d)\n", numRemainingSamples, samplesToComplete, samplesToComplete + numRemainingSamples - 1, workingSamplesPerSignal - 1);
                for (i = 0; i < numSignals; i++) {
                    memcpy(remainingSamples[i] + numRemainingSamples, workingSamples[i] + remainingIndex, sizeof (uint16) * samplesToComplete); //Copy remaining samples
                }
