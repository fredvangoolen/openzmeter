                }
                //printf("DRAM: %d\n", io->DRam[0]);
                //readed += packageSize;
                if (numSignals == 1) {
                    memcpy(adcSamples[0], &io->Adc->Value[bufStep * packageSize], sizeof (uint16) * packageSize);
                } else {
                    for (i = 0; i < packageSize; i++) {
                        adcSamples[i % numSignals][i / numSignals] = io->Adc->Value[bufStep * packageSize + i]; //Reordering buffer
                    }
                }
                /**
                 * STEP 1.1.2: Combine remainingSamples with new adcSamples to achieve packageSize. => We get workingSamples and adcRemainingSamples
                 */
                //Append remaining samples of previous read.
                if (numRemainingSamples > 0) {
                    debug_print_2("\nAñado restantes combinadas a workingSamples. Escribiendo a posición 0 la cantidad de %d muestras (Indice final de escritura: %d | indice máximo muestras: %d)\n", numRemainingSamples, numRemainingSamples - 1, workingSamplesPerSignal - 1);
                    for (i = 0; i < numSignals; i++) {
                        memcpy(workingSamples[i], remainingSamples[i], sizeof (uint16) * numRemainingSamples); //Copy remaining samples
                    }
                }
                //Complete buffer with ADC new samples
                int samplesToComplete = workingSamplesPerSignal - numRemainingSamples;
                if (samplesToComplete > 0) {
                    debug_print_2("\nCompleto workingSamples con las nuevas muestras del ADC. Escribiendo a posición %d la cantidad de %d muestras (Indice final de escritura: %d | indice máximo muestras: %d)\n", numRemainingSamples, samplesToComplete, numRemainingSamples + samplesToComplete - 1, workingSamplesPerSignal - 1);
                    for (i = 0; i < numSignals; i++) {
                        memcpy(workingSamples[i] + numRemainingSamples, adcSamples[i], sizeof (uint16) * samplesToComplete);
                    }
                }
                numRemainingSamples = 0;
                //Save ADC remaining Samples
                numAdcRemainingSamples = workingSamplesPerSignal - samplesToComplete;
