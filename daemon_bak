                 * STEP 3: Append adcRemainingSamples to remainingSamples.
                 */
                //Combine with adc remaining samples
                debug_print_2("\nCombino las restantes del ADC con las restantes de 10 ciclos. Escribiendo a posición samplesToComplete [%d] la cantidad de %d muestras (Indice final de escritura: %d| indice máximo muestras: %d)\n", samplesToComplete, numAdcRemainingSamples, samplesToComplete + numAdcRemainingSamples - 1, workingSamplesPerSignal - 1);
                for (i = 0; i < numSignals; i++) {
