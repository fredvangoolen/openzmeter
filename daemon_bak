        int64_t timeUsecTenSecondsStart = timeUsec;
        int totalCycles = 0;
        int j = 0;
        //printf("\nDRAM INIT: %d\n", io->DRam[0]);
        int firstRead = 1;
        while (j < 1) {
            debug_print_2("\n\n --------- ITERACION  %d ---\n", j);

            // PSEUDO CODE:
            // ============
            //1. count(remainingSamples) < packageSize?
            //  1.1. YES
            //    1.1.1. Read packageSize samples from ADC (adcSamples)
            //    1.1.2.  Combine remainingSamples with new adcSamples to achieve packageSize. => We get workingSamples and adcRemainingSamples
            //  1.2. NO
            //      1.2.1. workingSamples = remainingSamples
            //2. Get 10 cycles of the signal from workingSamples => signalSamples and remainingSamples
            //3. Append adcRemainingSamples to remainingSamples.
            //4. Insert work in thread pool.

            debug_print_2("\n * PASO 1\n");
            /**
             * STEP 1: Getting samples to work
             */
            if (numRemainingSamples < workingSamplesPerSignal) {
                /**
                 * STEP 1.1.1: Read packageSize samples from ADC (adcSamples)
                 */
                long r = 1;
                while (io->DRam[0] < (bufStep + 1) * packageSize - 1) {// && io->DRam[0] > bufStep * packageSize) {
                    usleep(10);
                    /*if (r % 100000 == 0) {
                        printf("Esperando DRAM: %d hasta %d \n", io->DRam[0], (bufStep + 1) * packageSize);
                        fflush(stdout);
                    }
                    r++;*/
                }
                for (i = 0; i < packageSize; i += 2) {
                    int muestra1 = io->Adc->Value[bufStep * packageSize + i];
                    int muestra2 = io->Adc->Value[bufStep * packageSize + i + 1];
                    float muestra1f = (((float) muestra1 / (float) MAX2E12)*2 - 1);
